<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Regression">
            <file>tests/Feature/AnimalAuthorizationTest.php</file>
            <file>tests/Feature/AnimalApiTest.php</file>
            <file>tests/Feature/RoleAccessTest.php</file>
            <file>tests/Feature/LostFoundTest.php</file>
            <file>tests/Feature/AdminUserTest.php</file>
            <file>tests/Feature/AnimalBugsTest.php</file>
            <file>tests/Feature/VetValidationTest.php</file>
            <file>tests/Feature/AnimalValidationTest.php</file>
            <file>tests/Feature/PhotoUploadTest.php</file>
            <file>tests/Feature/AnimalIntegrationTest.php</file>
            <file>tests/Feature/PagesDisplayTest.php</file>
            <file>tests/Unit/AdminMiddlewareTest.php</file>
            <file>tests/Unit/UserModelTest.php</file>
            <file>tests/Unit/AnimalModelTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- <env name="DB_CONNECTION" value="sqlite"/> -->
        <!-- <env name="DB_DATABASE" value=":memory:"/> -->
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>